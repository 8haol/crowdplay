# album-sign 的 secrets。线上用 `supabase secrets set --env-file <文件>` 设置（自己在终端跑，密钥不要贴进聊天或提交进仓库）；
# 本地 `supabase functions serve album-sign --env-file supabase/functions/album-sign/.env`。
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 由运行时自动注入，不用写在这里。

# --- 线上（Cloudflare R2） ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<只限这个 bucket 的 R2 API token 的 Access Key ID>
R2_SECRET_ACCESS_KEY=<对应的 Secret Access Key>
R2_BUCKET=lifepassport-albums
# 逗号分隔，精确匹配（协议 + 域名 + 端口，不带结尾斜杠）
ALLOWED_ORIGINS=https://<平台域名>,https://<另一个平台域名>

# --- 本地（MinIO 容器；函数跑在 Docker 里，所以用 host.docker.internal 访问宿主机） ---
# R2_ENDPOINT=http://host.docker.internal:9000
# 预签名 URL 是给宿主机上的浏览器用的，而它解析不了 host.docker.internal（Host 在签名里，不能事后替换），
# 所以本地要另给一个浏览器能访问的地址。线上 R2 不用设，默认等于 R2_ENDPOINT。
# R2_PUBLIC_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# R2_BUCKET=albums
# ALLOWED_ORIGINS=http://localhost:5173
# 可选：签名用的 region，默认 auto（R2 要求）。MinIO 若配置了 MINIO_REGION，就填成一样的。
# R2_REGION=us-east-1
